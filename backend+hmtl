function construirHTMLLinea(encabezados, fila, rowNumber, primerPagoAI, ultimoPagoAJ, mostrarBotonVentana) {
  const idx = Object.create(null);
  for (let i = 0; i < encabezados.length; i++) idx[encabezados[i]] = i;

  let htmlContent = '';
  
  // Extraemos el número de línea para usarlo en las secciones
  const numeroLinea = fila[CONFIG.INDICES.LINEA_CREDITO] ?? 'N/A';

  // ========== BOTÓN ABRIR EN VENTANA (POSICIÓN FIJA MEJORADA) ==========
  if (mostrarBotonVentana) {
    htmlContent += `
      <style>
        /* Contenedor fijo para el botón */
        #fixedButtonContainer {
          position: fixed !important;
          top: 0 !important;
          left: 0 !important;
          right: 0 !important;
          height: 70px !important;
          background: linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.95) 80%, transparent 100%);
          backdrop-filter: blur(8px);
          z-index: 999999 !important;
          display: flex;
          align-items: center;
          justify-content: flex-end;
          padding: 0 20px;
          box-shadow: 0 2px 8px rgba(0,0,0,0.1);
          border-bottom: 1px solid rgba(0,0,0,0.05);
        }
        
        /* Espaciador para evitar que el contenido quede detrás */
        #contentSpacer {
          height: 70px;
          width: 100%;
        }
        
        #openWindowBtn {
          padding: 10px 18px;
          border: none;
          border-radius: 8px;
          background: #2563eb;
          color: white;
          cursor: pointer;
          font-weight: 600;
          font-size: 14px;
          transition: all 0.2s ease;
          display: inline-flex;
          align-items: center;
          gap: 8px;
          box-shadow: 0 2px 6px rgba(37, 99, 235, 0.3);
          font-family: 'Poppins', 'Inter', sans-serif;
          white-space: nowrap;
          position: relative !important;
        }
        
        #openWindowBtn:hover {
          background: #1d4ed8;
          transform: translateY(-1px);
          box-shadow: 0 4px 8px rgba(37, 99, 235, 0.4);
        }
        
        #openWindowBtn:active {
          transform: translateY(0);
          box-shadow: 0 2px 4px rgba(37, 99, 235, 0.3);
        }
        
        #openWindowBtn:disabled {
          opacity: 0.6;
          cursor: not-allowed;
          transform: none;
        }
        
        #openWindowBtn.loading {
          background: #6b7280;
        }
        
        .btn-icon {
          width: 16px;
          height: 16px;
          flex-shrink: 0;
        }
        
        #openWindowBtn.loading .btn-icon {
          animation: spin 1s linear infinite;
        }
        
        @keyframes spin {
          to { transform: rotate(360deg); }
        }
        
        @media (max-width: 600px) {
          #fixedButtonContainer {
            height: 60px !important;
            padding: 0 15px;
          }
          
          #contentSpacer {
            height: 60px;
          }
          
          #openWindowBtn {
            padding: 8px 14px;
            font-size: 12px;
          }
          
          #openWindowBtn span:not(.btn-icon) {
            display: none;
          }
        }
      </style>
      
      <div id="fixedButtonContainer">
        <button id="openWindowBtn" onclick="abrirEnNuevaVentana(${rowNumber})" title="Abrir en pestaña del navegador">
          <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
          </svg>
          <span>Abrir en pestaña nueva</span>
        </button>
      </div>
      
      <div id="contentSpacer"></div>
      
      <script>
        function abrirEnNuevaVentana(rowNum) {
          const btn = document.getElementById('openWindowBtn');
          const icon = btn.querySelector('.btn-icon');
          const text = btn.querySelector('span:not(.btn-icon)');
          
          btn.classList.add('loading');
          btn.disabled = true;
          btn.style.background = '#6b7280';
          
          // Cambiar a ícono de loading
          icon.innerHTML = '<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none" opacity="0.25"></circle><path d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" fill="currentColor"></path>';
          if (text) text.textContent = 'Generando...';
          
          google.script.run
            .withSuccessHandler(function(result) {
              if (result && result.success) {
                // Abrir en nueva pestaña
                const w = window.open('about:blank', '_blank');
                if (w) {
                  w.document.open();
                  w.document.write(result.html);
                  w.document.close();
                } else {
                  alert('Por favor, permite ventanas emergentes para abrir la visualización');
                }
                
                // Restaurar botón
                btn.classList.remove('loading');
                btn.disabled = false;
                btn.style.background = '#2563eb';
                icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>';
                if (text) text.textContent = 'Abrir en pestaña nueva';
              } else {
                alert('Error: ' + (result.message || 'No se pudo generar el contenido'));
                restaurarBoton(btn, icon, text);
              }
            })
            .withFailureHandler(function(error) {
              alert('Error al abrir ventana: ' + error.message);
              restaurarBoton(btn, icon, text);
            })
            .abrirEnVentanaCompleta(rowNum);
        }
        
        function restaurarBoton(btn, icon, text) {
          btn.classList.remove('loading');
          btn.disabled = false;
          btn.style.background = '#2563eb';
          icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>';
          if (text) text.textContent = 'Abrir en pestaña nueva';
        }
      </script>
    `;
  }

  // ========== HEADER ==========
  htmlContent += generarHTMLHeader(fila, idx);

  // ========== INFORMACIÓN RELEVANTE (DESPUÉS DEL HEADER) ==========
  const valorIRaw = fila[CONFIG.INDICES.INFO_RELEVANTE_I];
  const valorGRaw = fila[CONFIG.INDICES.INFO_RELEVANTE_G];
  const valorJRaw = fila[CONFIG.INDICES.INFO_RELEVANTE_J];
  
  let valorG = 'SIN DATOS';
  let esVacioG = true;
  if (valorGRaw !== null && valorGRaw !== undefined && String(valorGRaw).trim() !== '') {
    valorG = String(valorGRaw).trim();
    esVacioG = false;
  }
  
  let valorI = 'N/A';
  let esVacioI = true;
  if (valorIRaw !== null && valorIRaw !== undefined && String(valorIRaw).trim() !== '') {
    valorI = String(valorIRaw).trim();
    esVacioI = false;
  }

  let valorJ = 'N/A';
  let esVacioJ = true;
  if (valorJRaw !== null && valorJRaw !== undefined && String(valorJRaw).trim() !== '') {
    valorJ = String(valorJRaw).trim()
      .replace(/\n/g, '<br>')  
      .replace(/(\d+\.\s)/g, '<br>$1');  
    esVacioJ = false;
  }

  const nombreI = encabezados[CONFIG.INDICES.INFO_RELEVANTE_I] || 'Información I';
  const nombreG = encabezados[CONFIG.INDICES.INFO_RELEVANTE_G] || 'Información G';
  const nombreJ = encabezados[CONFIG.INDICES.INFO_RELEVANTE_J] || 'Condiciones:';

  htmlContent += `
    <section class="card-group" style="margin-top: 20px;">
      <div class="group-header">
        <div class="group-icon"><i class="material-icons">warning</i></div>
        <h3>Información Relevante <span style="font-size: 0.85em; color: var(--text-dark); margin-left: 8px; font-weight: normal;">| Línea: <span class="highlight">${numeroLinea}</span></span></h3>
      </div>
      
      <div class="card-container" style="margin-bottom: 20px;">
        <div class="info-card info-condiciones" style="grid-column: 1 / -1;">
          <div class="card-content">
            <div class="info-label">${nombreJ}</div>
            <div class="info-value ${esVacioJ ? 'empty' : 'text-formatted'}">${valorJ}</div>
          </div>
        </div>
      </div>
      
      <div class="card-container">
        <div class="info-card info-sensible" style="grid-column: 1 / -1;">
          <div class="card-content">
            <div class="info-label">${nombreI}</div>
            <div class="info-value ${esVacioI ? 'empty' : 'justified'}">${valorI}</div>
          </div>
        </div>
        <div class="info-card info-sensible" style="grid-column: 1 / -1;">
          <div class="card-content">
            <div class="info-label">${nombreG}</div>
            <div class="info-value ${esVacioG ? 'empty' : 'justified'}">${valorG}</div>
          </div>
        </div>
      </div>
    </section>
  `;

  // ========== GENERAR GRUPOS DE TARJETAS ==========
  for (const [nombreGrupo, configGrupo] of Object.entries(MAPEO_CAMPOS)) {
    htmlContent += `
      <section class="card-group">
        <div class="group-header">
          <div class="group-icon"><i class="material-icons">${configGrupo.icono}</i></div>
          <h3>${nombreGrupo} <span style="font-size: 0.85em; color: var(--text-dark); margin-left: 8px; font-weight: normal;">| Línea: <span class="highlight">${numeroLinea}</span></span></h3>
        </div>
        <div class="card-container">
    `;

    // Campos del grupo
    configGrupo.campos.forEach((nombre) => {
      const i = idx[nombre];
      if (i == null) return;
      const raw = fila[i];
      let formateado = (raw ?? 'N/A');

      if (FORMATOS_CAMPOS[nombre]) formateado = FORMATOS_CAMPOS[nombre](raw);
      else if (nombre === "Fecha de corte" && typeof formateado === "string" && /c\/m/i.test(formateado)) {
        formateado = formateado.replace(/(\d+)\s*c\/m/gi, '$1 Cada Mes');
      }

      let claseEspecial = '';
      let claseTarjetaExtra = configGrupo.claseTarjeta || '';
      let claseValorExtra = '';

      // Aplicar clase dinámica basada en el valor
      const claseDinamica = obtenerClaseDinamica(nombre, raw);
      if (claseDinamica) {
        claseTarjetaExtra = claseDinamica;
      }

      if (nombre === "Monto" || nombre === "Tasa" || nombre === "LC") {
        claseEspecial = 'highlight-value';
      } else if (nombre === "Estatus") {
        claseEspecial = 'status-value';
        if (raw && String(raw).toLowerCase() === "activo") claseEspecial += ' status-active';
      } else if (nombre === "Fecha Vencimiento LC") {
        claseEspecial = 'vencimiento-lc';
        if (!claseDinamica) claseTarjetaExtra += ' tarjeta-venc-lc';
      } else if (nombre === "Fecha Vencimiento") {
        claseEspecial = 'vencimiento';
      }

      // Solo aplica regimen-pf si NO hay clase dinámica
      if (nombre === "Régimen Fiscal" && String(raw || '').trim().toUpperCase() === "PF" && !claseDinamica) {
        claseTarjetaExtra += ' regimen-pf';
      }
      if (nombre === "Cliente") claseValorExtra += ' cliente-value';
      if (nombre === "Fecha Firma") claseValorExtra += ' fecha-firma';

      htmlContent += `
        <div class="info-card ${claseTarjetaExtra}">
          <div class="card-content">
            <div class="info-label">${nombre}</div>
            <div class="info-value ${!raw ? 'empty' : ''} ${claseEspecial} ${claseValorExtra}">${formateado}</div>
          </div>
        </div>
      `;
    });

    // Tarjetas extras para "Datos de la Solicitud"
    if (nombreGrupo === "Datos de la Solicitud") {
      const valorAI = (primerPagoAI || '').toString().trim();
      const textoAI = valorAI || 'N/A';
      htmlContent += `
        <div class="info-card tarjeta-fecha">
          <div class="card-content">
            <div class="info-label">Primer pago de interés</div>
            <div class="info-value ${!valorAI ? 'empty' : ''} highlight-value">${textoAI}</div>
          </div>
        </div>
      `;

      const valorAJ = (ultimoPagoAJ || '').toString().trim();
      const textoAJ = valorAJ || 'N/A';
      htmlContent += `
        <div class="info-card tarjeta-fecha-pago">
          <div class="card-content">
            <div class="info-label">Último pago Capital y/o interes</div>
            <div class="info-value ${!valorAJ ? 'empty' : ''} highlight-value">${textoAJ}</div>
          </div>
        </div>
      `;
    }

    htmlContent += `</div></section>`;
  }

  // ========== BOTÓN VALIDAR ==========
  htmlContent += `
    <div class="button-container">
      <button id="marcarCheckbox" class="action-button" onclick="marcarCheckbox(${rowNumber})">
        <span class="icon material-icons">verified</span>
        <span class="button-text">Validar Solicitud</span>
        <span class="checkmark"></span>
      </button>
      <div id="buttonMessage" class="status-message"></div>
    </div>
  `;

  return htmlContent;
}

function generarHTMLHeader(fila, idx) {
  const idxIDOpp = idx["ID Oportunidad"];
  let idOpp = 'N/A';
  if (idxIDOpp != null) {
    const idRaw = fila[idxIDOpp];
    if (idRaw) {
      const lineas = String(idRaw).split('\\n').filter(l => l.trim() !== '');
      idOpp = lineas.length ? lineas[lineas.length - 1].trim() : 'N/A';
    }
  }

  return `
    <div class="header">
      <h2><i class="material-icons" style="vertical-align: middle;">assignment</i> Detalle de Línea de Crédito</h2>
      <p class="subtitle">Línea: <span class="highlight">${fila[CONFIG.INDICES.LINEA_CREDITO] ?? 'N/A'}</span> |
        ID: <span class="highlight">${idOpp}</span>
      </p>
    </div>
  `;
}

function generarJSModal(rowNumber) {
  return `
    async function marcarCheckbox(rowNumber) {
      const button = document.getElementById('marcarCheckbox');
      const buttonText = button.querySelector('.button-text');
      const icon = button.querySelector('.icon');
      const message = document.getElementById('buttonMessage');

      button.classList.add('loading'); button.disabled = true;
      icon.textContent = 'hourglass_top'; buttonText.textContent = 'Validando...';

      google.script.run
        .withSuccessHandler(function(result) {
          button.classList.remove('loading');
          if (result && result.success) {
            button.classList.add('success');
            icon.textContent = 'done';
            buttonText.textContent = 'Validado';
            message.innerHTML = '<span style="color:#4CAF50">✓ Validado correctamente</span>';
          } else {
            button.classList.add('error');
            icon.textContent = 'error';
            buttonText.textContent = 'Error';
            message.innerHTML = '<span style="color:#F44336">✗ ' + (result && result.message ? result.message : 'Error') + '</span>';
            setTimeout(function(){ resetButton(button, icon, buttonText, message); }, 3000);
          }
        })
        .withFailureHandler(function(error) {
          button.classList.remove('loading'); button.classList.add('error');
          icon.textContent = 'error'; buttonText.textContent = 'Error';
          message.innerHTML = '<span style="color:#F44336">✗ ' + error.message + '</span>';
          setTimeout(function(){ resetButton(button, icon, buttonText, message); }, 3000);
        })
        .marcarCheckboxEnSheet(rowNumber);
    }

    function resetButton(button, icon, buttonText, message){
      button.classList.remove('error');
      icon.textContent='verified'; buttonText.textContent='Validar Solicitud';
      message.textContent=''; button.disabled=false;
    }
  `;
}

/* ============================================
   FUNCIÓN DE VALIDACIÓN
   ============================================ */
function marcarCheckboxEnSheet(rowNumber) {
  const hoja = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(CONFIG.HOJAS.SOLICITUDES);

  try {
    const estadoActual = hoja.getRange(rowNumber, CONFIG.COLUMNAS.CHECKBOX).getValue();
    if (estadoActual === true) {
      return { success: false, message: "Esta línea ya fue marcada previamente" };
    }

    hoja.getRange(rowNumber, CONFIG.COLUMNAS.CHECKBOX).setValue(true);
    hoja.getRange(rowNumber, CONFIG.COLUMNAS.FECHA_VALIDACION).setValue(new Date());
    hoja.getRange(rowNumber, CONFIG.COLUMNAS.COLOR_INDICADOR).setBackground('white');

    return { success: true, message: "Línea marcada como revisada" };
  } catch (error) {
    Logger.log(error);
    return { success: false, message: "Error al procesar: " + error.message };
  }
}

